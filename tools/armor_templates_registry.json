{
  "schema_version": 1,
  "_comment": [
    "[armor-template-generator] Human-maintained definition of the AI armour compositions.",
    "Read by tools/gen/gen_ai_armor_templates.py. Contains NO country tag and NO copied",
    "technology list: country classification stays in WA_AI_CONFIG, eligibility stays in the",
    "WA_AI_TEMPLATES_* scripted triggers named here by reference.",
    "Functional authority: documentation/WA_AI_ARMOR_GENERATOR_SPEC.md (decisions A1-A12)."
  ],
  "composition": {
    "line_budget": 10,
    "mobile_infantry": 5,
    "variant_block": 3,
    "target_width": 30,
    "battalion_width": 2.0,
    "regimental_slots": 5,
    "divisional_slots": 10,
    "waves": {
      "width_modifier": 0.5,
      "main_tank_delta": -1,
      "mechanized_delta": -2,
      "_comment": "A9: +0.5 is a FLAT per-battalion addition; 12 x 2.5 = 30 = 15 x 2.",
      "applies_to_motorized": false,
      "_motorized_comment": "A14 (OPEN): the screenshot's -2 names mechanized battalions. With the flat +0.5 every battalion is 2.5 wide, so a motorized division that holds the doctrine and has no wave twin is 15 x 2.5 = 37.5 wide. true emits motorized wave twins with the same -1/-2 and lands them on 30; false keeps the literal screenshot rule and leaves the motorized case oversized."
    },
    "medium_support_quota": [
      {
        "below_military_factories": 300,
        "count": 6
      },
      {
        "below_military_factories": 500,
        "count": 3
      },
      {
        "below_military_factories": null,
        "count": 0
      }
    ],
    "quota_triggers": {
      "6": "WA_AI_TEMPLATES_is_below_medium_support_first_cut",
      "3": "WA_AI_TEMPLATES_is_below_medium_support_second_cut"
    },
    "variant_block_mode": "count",
    "variant_block_width": 6,
    "_variant_block_comment": "A13 RESOLVED (owner, 2026-09-19): the block keeps the screenshot's 3 battalions. SPG line battalions are width 3 at base, but pre_assault_bombardment (width_assumptions) takes them to 2, so the block is 6 wide in every case. mode 'width' remains available if that assumption is ever dropped.",
    "width_assumptions": {
      "subdoctrines": [
        "pre_assault_bombardment"
      ],
      "_comment": "Width is computed with these sub-doctrines held. pre_assault_bombardment is tier 0 artillery, available = always yes, ai_will_do base = 1, and it takes combat_width -1 off every SPG line battalion: that is what makes the 3-battalion SPG block 6 wide like an assault or infantry-support block, and it is why A13 keeps the screenshot's 3 battalions. Drop a name from this list and the widths it pays for stop being true."
    },
    "motorized_plane": {
      "drop_axes": [
        "variant",
        "spaa"
      ],
      "_comment": "A country without mechanized infantry is a country one generation behind: the old ladder gave it 6 of its 124 medium targets. The motorized plane therefore carries the base composition and the regimental axes only - dropping the line variant and the SPAA company there removes a third of the whole product for a state every country leaves within a couple of years."
    }
  },
