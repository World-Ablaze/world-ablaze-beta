      "owner": {"file": "common/scripted_effects/WA_AI_CONSTRUCTION_PRIORITY_core.txt", "kind": "pdx_const", "name": "@AI_PC_ALLOC_FRACTION"},
      "mirrors": [
        {"file": "common/scripted_triggers/WA_AI_CONSTRUCTION_triggers.txt", "kind": "pdx_const", "name": "@AI_PC_ALLOC_FRACTION"},
        {"file": "events/wa_events_debug.txt", "kind": "pdx_const", "name": "@AI_PC_ALLOC_FRACTION", "note": "debug mirror of WA_AI_PC_can_afford_project"},
        {"file": ".claude/skills/wa-savegame-analysis/scripts/savegame.py", "kind": "py_assign", "name": "_PC_ALLOC_FRACTION"}
      ]
    },
    {
