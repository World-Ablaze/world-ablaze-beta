guiTypes = {

	# The Imperial Diet panel: one coloured square per seat of the House of Representatives (filled by the dynamic list of
	# common/scripted_guis/JAP_diet_scripted_gui.txt), the parties with their seats, then the support in both houses.
	# The parties are shown until the Imperial Rule Assistance Association exists; after that only the Association and
	# the Others are (the <name>_visible triggers of the scripted GUI).
