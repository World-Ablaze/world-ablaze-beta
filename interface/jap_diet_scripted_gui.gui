@PEERS_TEXT_X = 21
@REPRESENTATIVES_TEXT_X = 212
@HEADERS_Y = 67
@STATUS_Y = 52
guiTypes = {

	# The Imperial Diet panel, a copy of eng_parliament_decision_ui_window. The seat icons are Britain's for now.
	containerWindowType = {
		name = "jap_diet_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 92 }

		iconType = {
			name ="peers_icon"
			spriteType = "GFX_decision_category_eng_parliament_lords_ui"
			position = { x= 55	 y = -17 }
		}

		instantTextBoxType = {
			name ="peers_support_header"
			position = { x = @PEERS_TEXT_X y = @HEADERS_Y }
			font = "hoi_22chat"
			text = "JAP_diet_peers_support_header"
			format = center
			maxHeight = 24
		}

		instantTextBoxType = {
			name ="status_peers"
			position = { x = @PEERS_TEXT_X y = @STATUS_Y }
			font = "hoi_18mbs"
			text = "JAP_diet_peers_support_amount"
			format = center
		}

		iconType = {
			name ="representatives_icon"
			spriteType = "GFX_decision_category_eng_parliament_commons_ui"
			position = { x= 285 y = -17 }
		}

		instantTextBoxType = {
			name ="status_representatives"
			position = { x= @REPRESENTATIVES_TEXT_X y = @STATUS_Y }
			font = "hoi_18mbs"
			text = "JAP_diet_representatives_support_amount"
			format = center
			fixedsize = yes
			maxWidth = 280
		}

		instantTextBoxType = {
			name ="representatives_support_header"
			position = { x= @REPRESENTATIVES_TEXT_X y = @HEADERS_Y }
			font = "hoi_22chat"
			text = "JAP_diet_representatives_support_header"
			format = center
			maxHeight = 24
			fixedsize = yes
			maxWidth = 280
		}

	}
}
